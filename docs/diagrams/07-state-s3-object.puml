@startuml state-s3-object
skinparam state {
  BackgroundColor<<raw>> #FFE0B2
  BackgroundColor<<clean>> #C8E6C9
  BackgroundColor<<curated>> #BBDEFB
  BackgroundColor<<quarantine>> #FFCDD2
}

title UML State Diagram — Data Object Lifecycle Through S3 Zones

[*] --> Downloaded : OWID release

state "External Source" as EXT
state "raw/ zone" as RAW <<raw>> {
  state "Immutable CSV\nsnapshot" as R1
}
state "Processing" as PROC
state "clean/ zone" as CLEAN <<clean>> {
  state "Parquet partition\nby indicator + year" as C1
}
state "curated/ zone" as CUR <<curated>> {
  state "dim_region" as D1
  state "fact_health_indicator" as F1
}
state "quarantine/ zone" as QUAR <<quarantine>> {
  state "rejected rows\nwith reasons" as Q1
}
state "Athena Query" as ATH
state "Expired" as EXP

Downloaded --> EXT
EXT --> R1 : Ingest Lambda\nPutObject
R1 --> PROC : S3 ObjectCreated\nevent
PROC --> C1 : Clean Lambda\nvalid rows
PROC --> D1 : Clean Lambda
PROC --> F1 : Clean Lambda
PROC --> Q1 : Clean Lambda\ninvalid rows

C1 --> ATH : Glue Crawler\nregisters schema
D1 --> ATH
F1 --> ATH

R1 --> EXP : Lifecycle:\n30d → Standard-IA\n90d → Glacier
Q1 --> EXP : Lifecycle:\n30d expire
ATH --> EXP : athena-results/\n7d expire

note right of R1
  Versioning enabled
  Write once, never overwrite
end note

note right of C1
  Overwritten only by
  clean role on re-run
end note

@enduml
