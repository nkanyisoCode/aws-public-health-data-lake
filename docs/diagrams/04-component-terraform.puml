@startuml component-terraform
skinparam componentStyle rectangle

title UML Component Diagram — Terraform Modules

package "terraform/envs/dev" {
  [main.tf] as MAIN
  [dev.tfvars] as VARS
  [backend.tf] as BACKEND
}

package "modules/data_lake" {
  component [S3 Bucket] as S3
  component [Lifecycle Rules] as LIFE
  component [Bucket Policy] as POL
  component [Logs Bucket] as LOGS
}

package "modules/ingestion" {
  component [Ingest Lambda] as IL
  component [Clean Lambda] as CL
  component [EventBridge Rule] as EB
  component [S3 Notification] as S3N
  component [IAM Roles] as IAM1
}

package "modules/analytics" {
  component [Glue Database] as GDB
  component [Glue Crawler] as GC
  component [Athena Workgroup] as ATH
}

package "modules/security" {
  component [SNS Topic] as SNS
  component [AWS Budget] as BUD
  component [CloudTrail] as CT
  component [GuardDuty] as GD
  component [AWS Config] as CFG
}

package "modules/network" <<optional>> {
  component [VPC] as VPC
  component [S3 Gateway EP] as S3EP
  component [Secrets Manager EP] as SMEP
}

package "modules/warehouse" <<optional>> {
  component [RDS PostgreSQL] as RDS
}

package "modules/cicd" {
  component [GitHub OIDC] as OIDC
  component [Plan Role] as PLAN
  component [Apply Role] as APPLY
}

MAIN --> S3
MAIN --> IL
MAIN --> CL
MAIN --> GDB
MAIN --> SNS
MAIN --> VPC : enable_network
MAIN --> RDS : enable_rds
MAIN --> OIDC : enable_github_oidc

IL --> S3 : write raw/
EB --> IL : schedule
S3N --> CL : S3 event
CL --> S3 : read raw/\nwrite clean/
CL --> GC : StartCrawler
GC --> GDB
GC --> S3 : read clean/
ATH --> S3 : query results

CL ..> VPC : optional VPC config
CL ..> RDS : optional secret
SNS <-- IL : alarm
SNS <-- CL : alarm
CT --> LOGS
CFG --> LOGS

BACKEND ..> [S3 State Bucket] : remote state

note right of S3N
  Key enhancement:
  automatic clean trigger
  on raw/*.csv upload
end note

@enduml
