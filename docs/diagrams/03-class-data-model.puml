@startuml class-data-model
skinparam classAttributeIconSize 0
hide empty members

title UML Class Diagram — Curated Star Schema (Domain Model)

class DimRegion {
  +region_key: string <<PK>>
  +region_name: string
  +iso_code: string
  +region_type: enum
  --
  +country()
  +aggregate()
  +unknown()
}

class FactHealthIndicator {
  +region_key: string <<FK>>
  +year: int
  +indicator_code: string <<FK>>
  +indicator_name: string
  +indicator_category: string
  +value: decimal
  +is_missing: boolean
  +is_revised: boolean
  +is_estimated: boolean
  +loaded_at: datetime
}

class DimIndicator {
  +indicator_code: string <<PK>>
  +indicator_name: string
  +indicator_category: string
  +indicator_unit: string
}

class RejectedRow {
  +region_name: string
  +year: int
  +indicator_code: string
  +value: decimal
  +reject_reason: string
  --
  quarantine zone only
}

class RawSnapshot {
  +source: string
  +ingest_date: date
  +filename: string
  +format: csv
  --
  raw zone — write once
}

class CleanPartition {
  +indicator_code: string
  +year: int
  +format: parquet
  +path: string
  --
  clean zone — partitioned
}

enum RegionType {
  country
  aggregate
  unknown
  other
}

DimRegion "1" -- "0..*" FactHealthIndicator : has >
DimIndicator "1" -- "0..*" FactHealthIndicator : measures >
DimRegion --> RegionType

RawSnapshot ..> CleanPartition : clean Lambda\ntransforms
CleanPartition ..> FactHealthIndicator : derives
CleanPartition ..> DimRegion : derives
CleanPartition ..> RejectedRow : validation\nfailures

note bottom of FactHealthIndicator
  Stored in S3 curated/
  Queryable via Athena views:
  vw_vaccination_summary
  vw_who_threshold_gaps
end note

@enduml
