@startuml use-case-health-lake
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Use Case Diagram — Public Health Data Lake on AWS

actor "Data Engineer\n(you)" as DE
actor "EventBridge\nScheduler" as EB
actor "Reporting User\n(Analyst)" as RU
actor "GitHub Actions\nCI/CD" as GHA

rectangle "Public Health Data Lake System" {
  usecase "UC1: Schedule weekly\nOWID ingestion" as UC1
  usecase "UC2: Download public\nhealth CSV" as UC2
  usecase "UC3: Store raw snapshot\nin S3 raw zone" as UC3
  usecase "UC4: Clean and validate\ndata automatically" as UC4
  usecase "UC5: Write Parquet to\nclean zone" as UC5
  usecase "UC6: Build curated\nstar schema" as UC6
  usecase "UC7: Quarantine\ninvalid rows" as UC7
  usecase "UC8: Register schema\nin Glue Catalog" as UC8
  usecase "UC9: Query data\nwith Athena SQL" as UC9
  usecase "UC10: Deploy infrastructure\nwith Terraform" as UC10
  usecase "UC11: Receive alert\non pipeline failure" as UC11
  usecase "UC12: Monitor cost\nwith Budget alarm" as UC12
}

EB --> UC1
UC1 ..> UC2 : <<include>>
UC2 --> UC3
UC3 --> UC4 : S3 event
UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC4 ..> UC7 : <<extend>>
UC5 --> UC8
UC6 --> UC8
UC8 --> UC9

DE --> UC10
DE --> UC11
DE --> UC12
GHA --> UC10
RU --> UC9

DE --> UC2 : manual trigger
DE --> UC4 : local script

note right of UC7
  Rejected rows saved to
  quarantine/ prefix
  (30-day expiry)
end note

note bottom of UC10
  IaC modules: data_lake,
  ingestion, analytics,
  security, network, cicd
end note

@enduml
